{
  "datasets": [
    {
      "name": "ds_prio",
      "displayName": "Prioritas area",
      "queryLines": [
        "SELECT wilayah_id, nama_wilayah, populasi, indeks_risiko, jumlah_gempa, mag_maks, jumlah_laporan, jiwa_terdampak, jalan_putus, jalan_terbatas, skor_prioritas FROM workspace.kelompok2.gold_prioritas_area ORDER BY skor_prioritas DESC"
      ]
    },
    {
      "name": "ds_akses",
      "displayName": "Status akses fasilitas",
      "queryLines": [
        "SELECT a.jenis_fasilitas, a.jumlah_fasilitas, a.akses_putus, a.akses_terbatas, a.akses_lancar, p.nama_wilayah FROM workspace.kelompok2.gold_status_akses_fasilitas a JOIN workspace.kelompok2.gold_prioritas_area p USING (wilayah_id)"
      ]
    },
    {
      "name": "ds_bantuan",
      "displayName": "Rekap kebutuhan bantuan",
      "queryLines": [
        "SELECT b.kebutuhan_utama, b.jumlah_laporan, b.jiwa_terdampak, p.nama_wilayah FROM workspace.kelompok2.gold_rekap_bantuan b JOIN workspace.kelompok2.gold_prioritas_area p USING (wilayah_id)"
      ]
    },
    {
      "name": "ds_quarantine",
      "displayName": "Quarantine Silver",
      "queryLines": [
        "SELECT alasan, jenis_record, COUNT(*) AS jumlah FROM workspace.kelompok2.silver_quarantine GROUP BY alasan, jenis_record"
      ]
    }
  ],
  "pages": [
    {
      "name": "gold",
      "displayName": "Prioritas Mitigasi",
      "layout": [
        {
          "widget": {
            "name": "judul",
            "multilineTextboxSpec": {
              "lines": [
                "## Prioritas Mitigasi Gempa NTT — Lapisan Gold\n",
                "Kelompok 2 · Praktikum Data Storage (Databricks Lakehouse). Sumber: tabel `workspace.kelompok2.gold_*`. Gempa dari USGS/BMKG (asli); **laporan lapangan, populasi, dan indeks risiko adalah data sintetis berlabel.**"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_jiwa",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_prio",
                  "fields": [
                    {
                      "name": "sum(jiwa_terdampak)",
                      "expression": "SUM(`jiwa_terdampak`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(jiwa_terdampak)",
                  "displayName": "Jiwa terdampak"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Jiwa terdampak",
                "showDescription": true,
                "description": "Total dari laporan lapangan aktif"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
